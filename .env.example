SESSION_SECRET=change-me
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5001/auth/callback
DISCORD_ADMIN_ROLE_ID=
DISCORD_GUILD_ID=
DEVDOCS_URL=

# Comma-separated extra origins allowed to open Socket.IO connections.
# Leave empty for same-origin only (the safe default).
ALLOWED_ORIGINS=
# Set to 1 when serving over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=0
